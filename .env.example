# Server-side Supabase connection. The site falls back to in-memory demo data
# when these values are not set, so user testing can begin immediately.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use a long random value in production. It is used when hashing anonymous
# session IDs, recovery codes, and moderation metadata.
UNSAID_SERVER_SECRET=

# Optional public label shown in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
